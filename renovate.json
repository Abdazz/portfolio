{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],
  "regexManagers": [
    {
      "description": "Track Alpine chromium package version pinned via ARG in Dockerfile",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\nARG [A-Z_]+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["composer"],
      "groupName": "PHP dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "Node dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "matchPackageNames": ["postgres", "redis", "nginx", "caddy"],
      "groupName": "Docker service images",
      "automerge": false
    }
  ]
}
