{
  "permissions": {
    "allow": [
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(php artisan *)",
      "Bash(vendor/bin/* *)",
      "Bash(npm run *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(curl *)",
      "Bash(echo *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(python3 *)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__laravel-boost__database-schema",
      "mcp__laravel-boost__search-docs",
      "Bash(composer info *)",
      "Bash(sed *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(chmod -R 777 *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
