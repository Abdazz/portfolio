APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# In production set LOG_CHANNEL=stderr so container logs go to Docker's log driver.

# Flare — Laravel error tracking (https://flareapp.io)
FLARE_KEY=

# Database — defaults target the docker-compose Postgres service.
# For host-native dev: change DB_HOST to 127.0.0.1 (and DB_PORT to 5433 if reaching the
# container from the host, or 5432 for a native install).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=secret

SESSION_DRIVER=redis
# Session idle timeout in minutes. §5.3.1: 120 min is the admin idle-session limit.
# Shorten (e.g. 60) in production for higher-security deployments.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Redis — points at the compose service. For host-native dev: 127.0.0.1 + REDIS_PORT=6380.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Mailpit catches all outbound mail in dev.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@portfolio.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — backups (pg_dump + media mirror)
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=portfolio-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile — protects the contact form.
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty in local dev to skip verification (TurnstileService auto-bypasses).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Browsershot / PDF generation — Chromium path inside the Docker container.
# Set BROWSERSHOT_CHROME_PATH to the Chromium binary installed in the image.
# Leave NODE/NPM paths empty to use PATH resolution.
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NPM_PATH=

# Seeded admin (override in real deployments)
ADMIN_EMAIL=admin@portfolio.test
ADMIN_NAME="Portfolio Admin"
ADMIN_PASSWORD=password

# Compose port mappings (host side). Override if any clash with local services.
APP_PORT=8080
DB_PORT_HOST=5433
REDIS_PORT_HOST=6380
VITE_PORT=5173
MAIL_PORT_HOST=1025
MAIL_UI_PORT=8025
